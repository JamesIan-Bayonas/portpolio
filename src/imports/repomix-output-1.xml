<file path="src/components/Navbar.jsx">
import { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";

const links = [
  { id: "about", label: "About" },
  { id: "process", label: "Process" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills" },
  { id: "contact", label: "Contact" },
];

export default function Navbar() {
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState("");

  useEffect(() => {
    const handleScroll = () => {
      const scrollY = window.scrollY;
      const offset = 180;

      let currentSection = "";

      links.forEach((link, index) => {
        const section = document.getElementById(link.id);

        if (!section) return;

        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;

        // last section fix
        if (index === links.length - 1) {
          if (
            window.innerHeight + window.scrollY >=
            document.body.offsetHeight - 50
          ) {
            currentSection = link.id;
          }
        } else {
          if (
            scrollY >= sectionTop - offset &&
            scrollY < sectionTop + sectionHeight - offset
          ) {
            currentSection = link.id;
          }
        }
      });

      setActive(currentSection);
    };

    window.addEventListener("scroll", handleScroll);

    handleScroll();

    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  return (
    <>
      {/* NAVBAR */}
      <nav className="fixed top-0 left-0 w-full z-50 border-b border-[var(--line)] bg-[var(--ink)]/90 backdrop-blur-sm">
        <div className="max-w-6xl mx-auto flex items-center justify-between px-6 py-4 sm:px-8">
          {/* Logo */}
          <div className="font-[var(--font-display)] text-base font-semibold tracking-tight text-[var(--paper)]">
            <a href="#" className="flex items-center gap-2">
              <span className="mono text-xs text-[var(--mark)]">FR/</span>
              Fatima Rahmani
            </a>
          </div>

          {/* Links */}
          <div className="hidden md:flex items-center gap-9 text-sm mono">
            {links.map((link) => (
              <a
                key={link.id}
                href={`#${link.id}`}
                onClick={() => setOpen(false)}
                className={`relative pb-1 transition ${
                  active === link.id
                    ? "text-[var(--paper)]"
                    : "text-[var(--fade)] hover:text-[var(--paper)]"
                }`}
              >
                {link.label.toLowerCase()}

                {active === link.id && (
                  <motion.span
                    layoutId="underline"
                    className="absolute left-0 -bottom-[1px] w-full h-[1.5px] bg-[var(--mark)]"
                  />
                )}
              </a>
            ))}
          </div>

          {/* Hamburger Menu */}
          <button
            onClick={() => setOpen(!open)}
            className="md:hidden p-2 text-lg text-[var(--paper)]"
          >
            ☰
          </button>
        </div>
      </nav>

      {/* MOBILE MENU */}
      <AnimatePresence>
        {open && (
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -20 }}
            className="fixed top-16 inset-x-6 z-40 border border-[var(--line)] bg-[var(--panel)] rounded-md p-6 flex flex-col gap-4 text-center mono text-[var(--paper)] shadow-xl"
          >
            {links.map((link) => (
              <a
                key={link.id}
                className="hover:text-[var(--mark)] transition text-base"
                href={`#${link.id}`}
                onClick={() => setOpen(false)}
              >
                {link.label.toLowerCase()}
              </a>
            ))}
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}
</file>

