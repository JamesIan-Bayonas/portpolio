<file path="src/index.css">
@import "tailwindcss";
@import "@fontsource/space-grotesk/500.css";
@import "@fontsource/space-grotesk/600.css";
@import "@fontsource/space-grotesk/700.css";
@import "@fontsource/inter/400.css";
@import "@fontsource/inter/500.css";
@import "@fontsource/jetbrains-mono/400.css";
@import "@fontsource/jetbrains-mono/500.css";

:root {
  color-scheme: dark;

  /* Ink & paper — a drafting-table palette, not a glow palette */
  --ink: #0c0d10;
  --panel: #17181b;
  --panel-raised: #1d1e22;
  --line: #2a2c31;
  --line-strong: #3c3f45;
  --paper: #ede9e1;
  --fade: #8d897f;

  /* One precision accent — a red-pencil mark, used sparingly */
  --mark: #d3992d;
  --mark-dim: rgba(217, 164, 65, 0.16);

  --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", monospace;

  --shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
}

html {
  scroll-behavior: smooth;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-body);
  background-color: var(--ink);
  color: var(--paper);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Faint drafting grid instead of glow blobs — a nod to precision, kept quiet */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  background-image:
    linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(
    ellipse 80% 60% at 50% 0%,
    black 40%,
    transparent 100%
  );
  pointer-events: none;
}

section {
  position: relative;
  background: transparent;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  letter-spacing: -0.01em;
}

.mono {
  font-family: var(--font-mono);
}

/* Hairline card — sharp corners, one crisp border, no blur, no glow */
.section-card {
  border: 1px solid var(--line);
  background: var(--panel);
  box-shadow: var(--shadow);
  border-radius: 0.375rem;
  transition:
    border-color 0.25s ease,
    background 0.25s ease;
}

.section-card:hover {
  border-color: var(--line-strong);
  background: var(--panel-raised);
}

.section-title {
  color: var(--paper);
}

.section-subtitle {
  color: var(--mark);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  padding: 0.85rem 1.5rem;
  background: var(--mark);
  color: #0c0d10;
  font-weight: 600;
  transition:
    transform 0.18s ease,
    background 0.18s ease;
}

.button-primary:hover {
  background: #be851b;
  transform: translateY(-1px);
}

.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  border-radius: 0.375rem;
  padding: 0.85rem 1.5rem;
  border: 1px solid var(--line-strong);
  background: transparent;
  color: var(--paper);
  transition:
    border-color 0.18s ease,
    background 0.18s ease;
}

.button-secondary:hover {
  background: var(--panel);
  border-color: var(--fade);
}

.projects-container {
  scroll-snap-type: y mandatory;
}

.project-section {
  scroll-snap-align: start;
}

/* Signature detail: corner tick marks, like a design tool's inspect mode.
   Hidden by default, revealed with precision on hover — the one
   deliberate flourish on the page. */
.tick-corner {
  position: absolute;
  width: 14px;
  height: 14px;
  border-color: var(--mark);
  opacity: 0;
  transition: opacity 0.2s ease;
}
.group:hover .tick-corner {
  opacity: 1;
}
.tick-tl {
  top: 10px;
  left: 10px;
  border-top: 1.5px solid;
  border-left: 1.5px solid;
}
.tick-tr {
  top: 10px;
  right: 10px;
  border-top: 1.5px solid;
  border-right: 1.5px solid;
}
.tick-bl {
  bottom: 10px;
  left: 10px;
  border-bottom: 1.5px solid;
  border-left: 1.5px solid;
}
.tick-br {
  bottom: 10px;
  right: 10px;
  border-bottom: 1.5px solid;
  border-right: 1.5px solid;
}
</file>

