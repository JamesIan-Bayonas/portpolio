function ProjectCard({ project, index }) {
  const ref = useRef(null);

  const { scrollYProgress } = useScroll({
    target: ref,
    offset: ["start 0.95", "end 0.35"],
  });

  const opacity = useTransform(scrollYProgress, [0, 1], [0.5, 1]);

  const isEven = index % 2 === 0;

  return (
    <div
      className={`flex flex-col gap-6 md:items-stretch md:gap-8 ${
        isEven ? "md:flex-row-reverse" : "md:flex-row"
      }`}
    >
      <motion.div
        ref={ref}
        style={{ opacity }}
        className="group relative min-h-[280px] overflow-hidden rounded-md border border-[var(--line)] bg-[var(--panel)] md:min-h-[380px] md:w-1/2"
      >
        {project.image ? (
          <img
            src={project.image}
            alt={project.title}
            className="h-full w-full object-top"
          />
        ) : (
          <div className="flex h-full w-full items-center justify-center bg-[var(--panel)]">
            <span className="mono px-8 text-center text-lg text-[var(--fade)] transition group-hover:text-[var(--paper)]">
              {project.title}
            </span>
          </div>
        )}

        {/* inspect-mode corner ticks — signature detail */}
        <span className="tick-corner tick-tl" />
        <span className="tick-corner tick-tr" />
        <span className="tick-corner tick-bl" />
        <span className="tick-corner tick-br" />

        {/* coordinate readout, bottom-left, like a design tool's inspector */}
        <span className="tick-corner mono absolute bottom-3 left-3 !h-auto !w-auto border-0 text-[10px] text-[var(--mark)]">
          {project.tags?.[0] ?? "PROJECT"} · {String(index).padStart(2, "0")}
        </span>
      </motion.div>

      <motion.div className="w-full md:w-1/2">
        <div className="section-card h-full p-5 sm:p-6">
          <p className="mono text-[10px] uppercase tracking-[0.28em] text-[var(--mark)]">
            Project {String(index).padStart(2, "0")} /{" "}
            {String(projects.length).padStart(2, "0")}
          </p>

          <h3 className="mt-3 font-[var(--font-display)] text-xl font-semibold leading-tight md:text-2xl">
            {project.title}
          </h3>

          <p className="mt-3 text-sm leading-relaxed text-[var(--fade)]">
            {project.desc}
          </p>

          {project.tags && (
            <div className="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span
                  key={tag}
