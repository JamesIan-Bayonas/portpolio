import { useEffect, useRef, useState, type ReactNode } from "react"

const linePairs = [
  {
    old: '  role: "builds websites for clients",',
    next: '  role: "architects scalable distributed systems",',
  },
  {
    old: '  approach: "solves bugs when they appear",',
    next: '  approach: "eliminates failure modes before production",',
  },
  {
    old: '  scope: "knows React and some backend",',
    next: '  scope: "owns the full stack, schema through deploy",',
  },
]

const CHAR_DELAY = 32
const LINE_STAGGER = 300
const INITIAL_PAUSE = 400

function usePrefersReducedMotion() {
  const [reduced, setReduced] = useState(false)
  useEffect(() => {
    const mq = window.matchMedia("(prefers-reduced-motion: reduce)")
    setReduced(mq.matches)
    const handler = (e: MediaQueryListEvent) => setReduced(e.matches)
    mq.addEventListener("change", handler)
    return () => mq.removeEventListener("change", handler)
  }, [])
  return reduced
}

function DiffPanel() {
  const reduced = usePrefersReducedMotion()
  const [typedLines, setTypedLines] = useState<string[]>(["", "", ""])
  const [visibleLines, setVisibleLines] = useState<boolean[]>([false, false, false])
  const ran = useRef(false)

  useEffect(() => {
    if (ran.current) return
    ran.current = true

    if (reduced) {
      setTypedLines(linePairs.map((p) => p.next))
      setVisibleLines([true, true, true])
      return
    }

    const delay = (ms: number) => new Promise<void>((r) => setTimeout(r, ms))

    async function typeText(
      target: string,
      idx: number,
    ) {
      setVisibleLines((prev) => prev.map((v, i) => (i === idx ? true : v)))
      for (let c = 1; c <= target.length; c++) {
        setTypedLines((prev) => prev.map((l, i) => (i === idx ? target.slice(0, c) : l)))
        await delay(CHAR_DELAY)
      }
    }

    ;(async () => {
      await delay(INITIAL_PAUSE)
      for (let i = 0; i < linePairs.length; i++) {
        if (i > 0) await delay(LINE_STAGGER)
        await typeText(linePairs[i].next, i)
      }
    })()
  }, [reduced])

  return (
    <div
      className="border"
      style={{
        backgroundColor: "var(--color-surface)",
        borderColor: "var(--color-border)",
        borderRadius: "4px",
        overflow: "hidden",
      }}
    >
      {/* Title bar */}
      <div
        className="flex items-center gap-3 px-4 py-3 border-b"
        style={{ borderColor: "var(--color-border)" }}
      >
        <div className="flex items-center gap-1.5">
          <span className="w-3 h-3 rounded-full" style={{ backgroundColor: "#FF5F57" }} />
          <span className="w-3 h-3 rounded-full" style={{ backgroundColor: "#FFBD2E" }} />
          <span className="w-3 h-3 rounded-full" style={{ backgroundColor: "#28C840" }} />
        </div>
        <span
          className="text-xs"
          style={{ fontFamily: "var(--font-mono)", color: "var(--color-text2)" }}
        >
          developer.config.ts
        </span>
        <span
          className="ml-auto text-xs px-2 py-0.5 border"
          style={{
            fontFamily: "var(--font-mono)",
            color: "var(--color-diff-add)",
            borderColor: "var(--color-border)",
            borderRadius: "4px",
          }}
        >
          +3 −3
        </span>
      </div>

      {/* Diff body */}
      <div className="p-0 text-sm leading-7" style={{ fontFamily: "var(--font-mono)" }}>
        {/* Static preamble */}
        <DiffLine type="ctx">{"const config = {"}</DiffLine>
        <DiffLine type="ctx">{"  name: \"Alex Chen\","}</DiffLine>

        {/* Animated line pairs */}
        {linePairs.map((pair, i) => (
          <div key={i}>
            <DiffLine type="remove">{pair.old}</DiffLine>
            {visibleLines[i] && (
              <DiffLine type="add">
                {typedLines[i]}
                {typedLines[i].length < pair.next.length && (
                  <span
                    className="inline-block w-1.5 h-4 align-middle animate-pulse"
                    style={{ backgroundColor: "var(--color-accent)", marginLeft: "1px" }}
                  />
                )}
              </DiffLine>
            )}
          </div>
        ))}

        {/* Static close */}
        <DiffLine type="ctx">{"}"}</DiffLine>

        {/* Commit caption */}
        <div
          className="px-4 pt-4 pb-4 border-t text-xs italic"
          style={{
            borderColor: "var(--color-border)",
            fontFamily: "var(--font-serif)",
            color: "var(--color-text2)",
          }}
        >
          refactor: clarify self-description to match actual scope of work
        </div>
      </div>
    </div>
  )
}

function DiffLine({
  type,
  children,
}: {
  type: "add" | "remove" | "ctx"
  children: ReactNode
}) {
  const prefix = type === "add" ? "+" : type === "remove" ? "−" : " "
  const color =
    type === "add"
      ? "var(--color-diff-add)"
      : type === "remove"
        ? "var(--color-diff-remove)"
        : "var(--color-text2)"
  const bg =
    type === "add"
      ? "rgba(63, 185, 99, 0.08)"
      : type === "remove"
        ? "rgba(226, 88, 75, 0.08)"
        : "transparent"
  const strike = type === "remove"

  return (
    <div
      className="flex items-baseline gap-3 px-4"
      style={{ backgroundColor: bg, minHeight: "28px" }}
    >
      <span
        className="text-xs w-3 shrink-0 select-none"
        style={{ color, opacity: 0.7 }}
      >
        {prefix}
      </span>
      <span
        style={{
          color,
          textDecoration: strike ? "line-through" : "none",
          opacity: strike ? 0.55 : 1,
          wordBreak: "break-all",
        }}
      >
        {children}
      </span>
    </div>
  )
}

